//
// Key layout overview (all keys produce Russian by default):
//
//   `      1  2  3  4  5  6  7  8  9  0  -  =
//   ё      !  "  №  ;  %  :  ?  *  (  )  _  +
//                         (AltGr: £  €        ₽)
//
//   я  ш  е  р  т  ы  у  и  о  п  ю  щ
//   Я  Ш  Е  Р  Т  Ы  У  И  О  П  Ю  Щ
//
//   а  с  д  ф  г  ч  й  к  л  ь  ж  э
//   А  С  Д  Ф  Г  Ч  Й  К  Л  ъ  Ж  Э
//                           (Shift ; → ъ)
//
//   з  х  ц  в  б  н  м  ,  .  /
//   З  Х  Ц  В  Б  Н  М  <  >  ?
//
// AltGr (Right Alt) key activates Level 3:
//   AltGr + `  → dead_diaeresis (¨) — see XCompose file for combinations
//   AltGr + 3  → £  (U+00A3)
//   AltGr + 4  → €  (U+20AC)
//   AltGr + 8  → ₽  (U+20BD, Russian ruble sign)
//   AltGr + '  → '  (U+2019, right single quotation mark)
//
// Dead diaeresis (¨) combinations — defined in companion XCompose file:
//   ¨ + б → ъ    ¨ + ц → ч    ¨ + з → ж    ¨ + а → э
//   ¨ + г → ѓ    ¨ + с → ш    ¨ + ш → щ    ¨ + е → ё
//   ¨ + у → ю    ¨ + и → ї    ¨ + ы → ў    ¨ + о → ё
//   ¨ + ¨ → `    ¨ + Space → ¨
//
// ============================================================================

default partial alphanumeric_keys modifier_keys
xkb_symbols "les" {

    name[Group1] = "Russian (Phonetic - Les)";

    // ── Tilde / backtick row ─────────────────────────────────────────────────
    // Base: ё   Shift: Ё   AltGr: dead_diaeresis
    key <TLDE> { [ Cyrillic_io,       Cyrillic_IO,        dead_diaeresis   ] };

    // ── Number row ──────────────────────────────────────────────────────────
    key <AE01> { [ 1,                 exclam                               ] };
    key <AE02> { [ 2,                 quotedbl                             ] };
    key <AE03> { [ 3,                 numerosign,         sterling         ] };
    key <AE04> { [ 4,                 semicolon,          EuroSign         ] };
    key <AE05> { [ 5,                 percent                              ] };
    key <AE06> { [ 6,                 colon                                ] };
    key <AE07> { [ 7,                 question                             ] };
    key <AE08> { [ 8,                 asterisk,           U20BD            ] };
    key <AE09> { [ 9,                 parenleft                            ] };
    key <AE10> { [ 0,                 parenright                           ] };
    key <AE11> { [ minus,             underscore                           ] };
    key <AE12> { [ equal,             plus                                 ] };

    // ── Top row  (Q W E R T Y U I O P [ ]) ──────────────────────────────────
    key <AD01> { [ Cyrillic_ya,       Cyrillic_YA                          ] };  // Q → я
    key <AD02> { [ Cyrillic_sha,      Cyrillic_SHA                         ] };  // W → ш
    key <AD03> { [ Cyrillic_ie,       Cyrillic_IE                          ] };  // E → е
    key <AD04> { [ Cyrillic_er,       Cyrillic_ER                          ] };  // R → р
    key <AD05> { [ Cyrillic_te,       Cyrillic_TE                          ] };  // T → т
    key <AD06> { [ Cyrillic_yeru,     Cyrillic_YERU                        ] };  // Y → ы
    key <AD07> { [ Cyrillic_u,        Cyrillic_U                           ] };  // U → у
    key <AD08> { [ Cyrillic_i,        Cyrillic_I                           ] };  // I → и
    key <AD09> { [ Cyrillic_o,        Cyrillic_O                           ] };  // O → о
    key <AD10> { [ Cyrillic_pe,       Cyrillic_PE                          ] };  // P → п
    key <AD11> { [ Cyrillic_yu,       Cyrillic_YU                          ] };  // [ → ю
    key <AD12> { [ Cyrillic_shcha,    Cyrillic_SHCHA                       ] };  // ] → щ

    // ── Home row  (A S D F G H J K L ; ') ───────────────────────────────────
    key <AC01> { [ Cyrillic_a,        Cyrillic_A                           ] };  // A → а
    key <AC02> { [ Cyrillic_es,       Cyrillic_ES                          ] };  // S → с
    key <AC03> { [ Cyrillic_de,       Cyrillic_DE                          ] };  // D → д
    key <AC04> { [ Cyrillic_ef,       Cyrillic_EF                          ] };  // F → ф
    key <AC05> { [ Cyrillic_ghe,      Cyrillic_GHE                         ] };  // G → г
    key <AC06> { [ Cyrillic_che,      Cyrillic_CHE                         ] };  // H → ч
    key <AC07> { [ Cyrillic_shorti,   Cyrillic_SHORTI                      ] };  // J → й
    key <AC08> { [ Cyrillic_ka,       Cyrillic_KA                          ] };  // K → к
    key <AC09> { [ Cyrillic_el,       Cyrillic_EL                          ] };  // L → л
    key <AC10> { [ Cyrillic_softsign, Cyrillic_hardsign                    ] };  // ; → ь  Shift: ъ
    key <AC11> { [ Cyrillic_zhe,      Cyrillic_ZHE,       rightsinglequotemark ] }; // ' → ж  AltGr: '
    key <BKSL> { [ Cyrillic_e,        Cyrillic_E                           ] };  // \ → э

    // ── Bottom row  (Z X C V B N M , . /) ───────────────────────────────────
    key <AB01> { [ Cyrillic_ze,       Cyrillic_ZE                          ] };  // Z → з
    key <AB02> { [ Cyrillic_ha,       Cyrillic_HA                          ] };  // X → х
    key <AB03> { [ Cyrillic_tse,      Cyrillic_TSE                         ] };  // C → ц
    key <AB04> { [ Cyrillic_ve,       Cyrillic_VE                          ] };  // V → в
    key <AB05> { [ Cyrillic_be,       Cyrillic_BE                          ] };  // B → б
    key <AB06> { [ Cyrillic_en,       Cyrillic_EN                          ] };  // N → н
    key <AB07> { [ Cyrillic_em,       Cyrillic_EM                          ] };  // M → м
    key <AB08> { [ comma,             less                                  ] };  // , → ,  Shift: <
    key <AB09> { [ period,            greater                               ] };  // . → .  Shift: >
    key <AB10> { [ slash,             question                              ] };  // / → /  Shift: ?

    // ── Space ────────────────────────────────────────────────────────────────
    key <SPCE> { [ space,             space                                 ] };

    // ── 102nd key (between Left Shift and Z on ISO keyboards) ────────────────
    key <LSGT> { [ backslash,         slash                                 ] };

    // Right Alt → ISO Level 3 Shift (AltGr)
    include "level3(ralt_switch)"
};

